# Copy this file to .env.local for local overrides (gitignored). Every
# variable here is read in exactly one place — src/config/api.ts (backend
# API), src/config/site.ts (SEO), or src/config/ads.ts (advertising) —
# and nothing else in the app should ever reference a raw
# import.meta.env value for these concerns.

# --- Backend API (Phase 10 audit fix — was previously unwired) ---
# Base URL of the tier1-backend API. Empty (the default) means "same
# origin as this frontend" — correct once both are deployed behind the
# same domain/reverse proxy. For local development, where the Vite dev
# server and the backend run on different ports, set this explicitly,
# e.g. VITE_API_BASE_URL=http://localhost:4000
VITE_API_BASE_URL=

# --- SEO (Phase 8) ---
# Canonical production domain, no trailing slash. Falls back to a
# placeholder domain if unset.
VITE_SITE_URL=https://toolkit4me.com

# --- Advertising (Phase 9) ---
# Master switch. Leave unset/false for local development — no AdSense
# script is loaded and no real ad is requested when this is off, no
# matter what else below is set. Set to "true" only in a real deployment.
VITE_ADS_ENABLED=false

# AdSense publisher/client ID (e.g. "ca-pub-1234567890123456"). Required
# for any ad to render even when VITE_ADS_ENABLED=true.
VITE_ADSENSE_CLIENT_ID=

# Per-placement ad unit (slot) IDs from your AdSense account. A placement
# with no slot ID configured falls back to the development placeholder
# even when ads are otherwise enabled, so partially configuring these is
# safe — it just leaves that one placement unfilled rather than erroring.
VITE_AD_SLOT_BANNER=
VITE_AD_SLOT_RECTANGLE=
VITE_AD_SLOT_SIDEBAR=
VITE_AD_SLOT_MOBILE=
VITE_AD_SLOT_IN_CONTENT=
