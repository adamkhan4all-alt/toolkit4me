# Production build configuration — loaded automatically by `vite build`
# (Vercel runs this). Values here are baked into the client bundle, so
# only non-secret, public config belongs in this file.

# Backend API base URL. The tier1-backend service is deployed on an AWS
# EC2 instance behind nginx + HTTPS (Let's Encrypt), reachable at its own
# subdomain of the production domain. Read in exactly one place:
# src/config/api.ts. No trailing slash.
VITE_API_BASE_URL=https://api.toolkit4me.com

# --- SEO ---
# Canonical production domain (purchased 2026-09). No trailing slash.
# Vercel is configured with www as the primary domain (bare apex 308s to
# it), so the canonical URL must be the www form — pointing SEO/OG tags
# at a URL that immediately redirects elsewhere is the wrong default.
VITE_SITE_URL=https://www.toolkit4me.com
