# Production build configuration — loaded automatically by `vite build`
# (Vercel runs this). Values here are baked into the client bundle, so
# only non-secret, public config belongs in this file.

# Backend API base URL. The tier1-backend service is deployed on an AWS
# EC2 instance behind nginx + HTTPS (Let's Encrypt). Read in exactly one
# place: src/config/api.ts. No trailing slash.
VITE_API_BASE_URL=https://16-16-142-33.sslip.io

# --- SEO ---
# Canonical production domain (purchased 2026-09). No trailing slash.
# Matches the default in src/config/site.ts; set explicitly here so the
# production build never silently depends on that fallback matching.
VITE_SITE_URL=https://toolkit4me.com
