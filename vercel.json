{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/terms", "destination": "/terms-of-use", "permanent": true },
    { "source": "/url-tools", "destination": "/link-studio", "permanent": true },
    { "source": "/url-shortener", "destination": "/tools/url-shortener", "permanent": true },
    { "source": "/bulk-url-shortener", "destination": "/link-studio", "permanent": true },
    { "source": "/qr-code-generator", "destination": "/tools/qr-code-generator", "permanent": true },
    { "source": "/url-validator", "destination": "/tools/url-validator", "permanent": true },
    { "source": "/url-encoder-decoder", "destination": "/tools/url-encoder-decoder", "permanent": true },
    { "source": "/utm-builder", "destination": "/tools/utm-builder", "permanent": true },
    { "source": "/url-parser-cleaner", "destination": "/tools/url-parser-cleaner", "permanent": true },
    { "source": "/whatsapp-sticker-maker", "destination": "/tools/whatsapp-sticker-maker", "permanent": true },
    { "source": "/picture-avatar", "destination": "/tools/picture-avatar", "permanent": true },
    { "source": "/picture-to-anime", "destination": "/tools/picture-to-anime", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/icons.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(sitemap(?:-(?:pages|pdf-tools|image-tools|pixel-playground|calculators|developer-tools|link-studio|guides|blog)(?:-\\d+)?)?\\.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/link-studio/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
